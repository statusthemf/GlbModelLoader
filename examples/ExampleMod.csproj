
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WeaponModExample</AssemblyName>
    <RootNamespace>ULTRADROID.BladesOfChaos</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <RestoreAdditionalProjectSources>
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ULTRADROID.Models.csproj" />

    <PackageReference
      Include="BepInEx.Unity.IL2CPP"
      Version="6.0.0-be.*"
      IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>

    <Reference Include="Assembly-CSharp">
      <HintPath>../Assembly-CSharp.dll</HintPath>
    </Reference>

    <Reference Include="Il2Cppmscorlib">
      <HintPath>../Il2Cppmscorlib.dll</HintPath>
    </Reference>

    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>../Il2CppInterop.Runtime.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>../UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
